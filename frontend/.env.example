# Скопируйте в .env и заполните: cp .env.example .env
# Переменные с префиксом NEXT_PUBLIC_ попадают в браузерный бандл — секреты туда не класть.

# --- Приложение ---
# Публичный адрес фронтенда (ссылки-приглашения, редиректы после логина)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Backend ---
# REST API (NestJS)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Socket.IO (realtime симуляции)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- Telegram ---
# Имя бота для deep link привязки аккаунта (без @)
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# --- Sentry / GlitchTip ---
# DSN для отправки ошибок из браузера (пусто = отключено)
NEXT_PUBLIC_SENTRY_DSN=
# development | staging | production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Только для CI: загрузка source maps (хранить в GitHub Secrets)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
