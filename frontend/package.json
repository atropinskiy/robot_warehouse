{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "lint:fsd": "steiger ./src",
    "lint:all": "concurrently --names eslint,fsd --prefix \"[{index}:{name}]:\" --success all \"pnpm lint\" \"pnpm lint:fsd\""
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "steiger": "^0.9.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.18.0"
}
