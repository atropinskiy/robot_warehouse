    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "steiger": "^0.9.0",
    "storybook": "10.6.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.18.0"
